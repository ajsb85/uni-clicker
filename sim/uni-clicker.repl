flash: Memory.MappedMemory @ {
    sysbus 0x08000000;
    sysbus 0x00200000
}
    size: 0x100000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x50000

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m7"
    PerformanceInMips: 16
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 16000000
    IRQ -> cpu@0

rcc: Miscellaneous.STM32F4_RCC @ sysbus 0x40023800
    rtcPeripheral: rtc

pwr: Miscellaneous.STM32_PWR @ sysbus 0x40007000

flashController: MTD.STM32F4_FlashController @ sysbus 0x40023C00
    flash: flash

rtc: Timers.STM32F4_RTC @ sysbus 0x40002800

gpioC: GPIOPort.STM32_GPIOPort @ sysbus <0x40020800, +0x400>
    numberOfAFs: 16

gpioD: GPIOPort.STM32_GPIOPort @ sysbus <0x40020C00, +0x400>
    numberOfAFs: 16

ledC: Miscellaneous.LED @ gpioD 7

usart6: UART.STM32F7_USART @ sysbus 0x40011400
    frequency: 16000000
    IRQ -> nvic@71

timer2: Timers.STM32_Timer @ sysbus 0x40000000
    frequency: 16000000
    initialLimit: 0xFFFFFFFF
    -> nvic@28
